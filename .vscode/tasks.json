{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build kernel",
            "type": "shell",
            "command": "make -j$(nproc)",
            "options": {
                "cwd": "${workspaceFolder}/"
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "label": "Clean sources",
            "type": "shell",
            "command": "make mrproper",
            "options": {
                "cwd": "${workspaceFolder}/"
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "label": "Clean sources",
            "type": "shell",
            "command": "make mrproper",
            "options": {
                "cwd": "${workspaceFolder}/"
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
        {
            "label": "Get latest arch KConfig",
            "type": "shell",
            "command": "wget -O ArchKconfig https://gitlab.archlinux.org/archlinux/packaging/packages/linux/-/raw/main/config?ref_type=heads",
            "options": {
                "cwd": "${workspaceFolder}/"
            },
            "presentation": {
                "reveal": "always",
                "panel": "new",
                "focus": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
        },
    ]
}